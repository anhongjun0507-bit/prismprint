# ─────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────
# Supabase 프로젝트 생성 후 Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# ─────────────────────────────────────────────────────────
# Resend (이메일 발송)
# ─────────────────────────────────────────────────────────
# 1) https://resend.com 가입 후 API Keys 에서 발급
# 2) Domains 메뉴에서 발신 도메인 인증 (DNS 레코드 등록)
# 3) 인증 전에는 onboarding@resend.dev 만 발신자로 가능 (테스트용)
# 키가 비어있으면 메일 발송은 자동으로 skip 됨 (주문·상태 변경은 정상 동작).
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="PrismPrint <noreply@yourdomain.com>"

# ─────────────────────────────────────────────────────────
# 사이트 정보
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=PrismPrint

# ─────────────────────────────────────────────────────────
# 회사 정보 (Footer·약관·개인정보처리방침)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME=주식회사 예시
NEXT_PUBLIC_COMPANY_CEO=홍길동
NEXT_PUBLIC_COMPANY_BUSINESS_NUMBER=000-00-00000
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시 ○○구 ○○로 123
NEXT_PUBLIC_COMPANY_EMAIL=contact@example.com
NEXT_PUBLIC_COMPANY_HOURS=평일 09:00 - 18:00

# ─────────────────────────────────────────────────────────
# 무통장입금 계좌 정보
# Phase 2 에서 site_settings 테이블로 이관 예정
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BANK_NAME=우리은행
NEXT_PUBLIC_BANK_ACCOUNT=000-000-000000
NEXT_PUBLIC_BANK_HOLDER=홍길동

# ─────────────────────────────────────────────────────────
# 고객센터 정보
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CS_PHONE=02-0000-0000
NEXT_PUBLIC_CS_EMAIL=cs@example.com
